{
  "name": "@bracket/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for Bracket Dashboard",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "npm run build && electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@bracket/server": "*",
    "@bracket/shared": "*"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "gg.bracketdashboard.app",
    "productName": "Bracket Dashboard",
    "files": ["dist/**", "../server/dist/**", "../web/dist/**", "../shared/dist/**"],
    "mac": { "target": ["dmg"] },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage"] }
  }
}
