{
  "name": "@bracket/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for Bracket Dashboard",
  "author": "Voidscape Development",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "npm run build && electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@bracket/server": "*",
    "@bracket/shared": "*"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "gg.bracketdashboard.app",
    "productName": "Bracket Dashboard",
    "directories": { "output": "release" },
    "artifactName": "bracket-dashboard-${version}-${os}-${arch}.${ext}",
    "files": ["dist/**"],
    "extraResources": [{ "from": "../web/dist", "to": "web" }],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "win": { "target": ["nsis"] },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "executableName": "bracket-dashboard"
    },
    "npmRebuild": false,
    "publish": null
  }
}
