{
  "name": "@bracket/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "bracket-dashboard": "./dist/bin/serve.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "node --watch --experimental-strip-types src/bin/serve.ts",
    "test": "tsc -b && node --test --experimental-strip-types \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@bracket/shared": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.0.4",
    "@fastify/websocket": "^11.0.2",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/ws": "^8.5.13"
  }
}
